# ====================================================
# CẤU HÌNH BOT DISCORD GỢI Ý & ĐẶT ĐỒ UỐNG THÔNG MINH
# ====================================================

# 1. Token Bot từ Discord Developer Portal (Bắt buộc)
# Lấy tại: https://discord.com/developers/applications -> Chọn Bot -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. Server ID / Guild ID (Tùy chọn)
# Điền ID của Server Discord test để Bot đồng bộ Slash Commands tức thì (không phải đợi 1 tiếng toàn cầu).
# Cách lấy: Bật Developer Mode trên Discord -> Chuột phải vào tên Server -> Copy Server ID.
DISCORD_GUILD_ID=your_guild_id_here

# 3. Gemini API Key từ Google AI Studio (Bắt buộc cho não bộ AI)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
